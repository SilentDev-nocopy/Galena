## Live ESP32 dashboard served by RSNetwork.
##
## The device creates its own Wi-Fi network (AP mode) and serves a page that
## polls /call/status every second. The poll response is a pipe-separated list
## of key=value pairs; the small /rsclient.js script writes them into the
## elements marked with data-field. CPU load also drives a CSS ring gauge.
## A button toggles inline conversions next to each value: byte values gain
## bit/kB/MB, and uptime gains minutes once 60 seconds have passed. Everything
## the page shows comes from real
## RSSystem calls on the ESP32. On a PC this program cannot run because it calls
## Wi-Fi, so `make test` skips it.

<include> RSNetwork, RSSystem

c FPS float = 10.0
c port_number int = 8080
c ap_ssid string = "galena-dash"
c ap_password string = "galena123"

v wifi ModuleObject = RSNetwork.wifi()
v page ModuleObject = RSNetwork.html_server_handler()

## Single quotes inside the HTML and JS keep the Resiris string literals simple.
## Only the /call/<name>?value=<text> path returns data, so the dashboard uses
## one poll request and puts every metric into that single response.
c html_page string = "<!DOCTYPE html>\n<html lang='en'>\n<head>\n  <meta charset='utf-8'>\n  <meta name='viewport' content='width=device-width, initial-scale=1'>\n  <title>ESP32 dashboard</title>\n  <style>\n    body { font-family: system-ui, sans-serif; margin: 1.5rem; background: #101418; color: #e6eef5; }\n    h1 { margin-top: 0; font-size: 1.4rem; }\n    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }\n    button { background: #263846; color: #e6eef5; border: 1px solid #3d5263; border-radius: 8px; padding: 0.4rem 0.75rem; cursor: pointer; }\n    button:hover { background: #31495a; }\n    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.75rem; }\n    .card { background: #1b232b; border: 1px solid #2c3945; border-radius: 10px; padding: 0.9rem; }\n    .extra { color: #8fa6b8; font-size: 0.85rem; font-weight: 400; }\n    .label { color: #8fa6b8; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }\n    .value { font-size: 1.25rem; font-variant-numeric: tabular-nums; margin-top: 0.25rem; }\n    .cpu-row { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; }\n    .ring { flex: 0 0 auto; width: 72px; height: 72px; border-radius: 50%; background: #2c3945; position: relative; }\n    .ring::before { content: ''; position: absolute; inset: 8px; border-radius: 50%; background: #1b232b; }\n    .wide { grid-column: 1 / -1; }\n    footer { margin-top: 1rem; color: #8fa6b8; font-size: 0.85rem; }\n  </style>\n</head>\n<body>\n  <div class='toolbar'>\n    <h1>ESP32 live dashboard</h1>\n    <button id='units' type='button' aria-pressed='false'>Show conversions</button>\n  </div>\n  <div class='grid'>\n    <div class='card'><div class='label'>Uptime</div><div class='value'><span data-field='uptime'>--</span> s<span data-convert='uptime' class='extra'></span></div></div>\n    <div class='card'><div class='label'>CPU load</div><div class='cpu-row'><div class='value'><span data-field='cpu_load'>--</span> %</div><div class='ring' id='cpu-ring'></div></div></div>\n    <div class='card'><div class='label'>CPU speed</div><div class='value'><span data-field='cpu_speed'>--</span> MHz</div></div>\n    <div class='card'><div class='label'>Free heap</div><div class='value'><span data-field='heap_free'>--</span> B<span data-convert='heap_free' class='extra'></span></div></div>\n    <div class='card'><div class='label'>Min free heap</div><div class='value'><span data-field='heap_min'>--</span> B<span data-convert='heap_min' class='extra'></span></div></div>\n    <div class='card'><div class='label'>Heap total</div><div class='value'><span data-field='heap_total'>--</span> B<span data-convert='heap_total' class='extra'></span></div></div>\n    <div class='card'><div class='label'>PSRAM</div><div class='value'><span data-field='psram'>--</span> B<span data-convert='psram' class='extra'></span></div></div>\n    <div class='card'><div class='label'>Flash used / total</div><div class='value'><span data-field='flash_used'>--</span><span data-convert='flash_used' class='extra'></span> / <span data-field='flash_total'>--</span><span data-convert='flash_total' class='extra'></span></div></div>\n    <div class='card wide'><div class='label'>Chip</div><div class='value'><span data-field='chip'>--</span> rev <span data-field='chip_revision'>--</span></div></div>\n    <div class='card wide'><div class='label'>Modules</div><div class='value'><span data-field='modules'>--</span></div></div>\n  </div>\n  <footer>Updated <span data-field='updated'>connecting...</span></footer>\n  <script src='/rsclient.js'></script>\n</body>\n</html>"

## Polling client. It never uses a newline escape inside a JS string literal:
## the response is split on '|', so the Resiris \n escapes only create real
## line breaks between JS statements.
c rsclient_js string = "(() => {\n  const statusUrl = '/call/status?value=tick';\n  let busy = false;\n  let latest = {};\n  let showConversions = false;\n\n  function byteExtra(raw) {\n    const n = Number(raw);\n    if (!Number.isFinite(n)) return '';\n    return ' = ' + Math.round(n * 8).toLocaleString() + ' bit = ' + (n / 1000).toFixed(1) + ' kB = ' + (n / 1000000).toFixed(2) + ' MB';\n  }\n\n  function minuteExtra(raw) {\n    const n = Number(raw);\n    if (!Number.isFinite(n) || n < 60) return '';\n    return ' = ' + (n / 60).toFixed(2) + ' min';\n  }\n\n  function updateRing(raw) {\n    const ring = document.getElementById('cpu-ring');\n    if (!ring) return;\n    const n = Number(raw);\n    if (!Number.isFinite(n)) return;\n    const pct = Math.max(0, Math.min(100, n));\n    const color = pct > 80 ? '#ff6b6b' : pct > 50 ? '#ffd166' : '#4fd1c5';\n    ring.style.background = 'conic-gradient(' + color + ' ' + pct.toFixed(1) + '%, #2c3945 ' + pct.toFixed(1) + '%)';\n  }\n\n  function render() {\n    document.querySelectorAll('[data-field]').forEach(el => {\n      const key = el.getAttribute('data-field');\n      if (latest[key] !== undefined) el.textContent = latest[key];\n    });\n    updateRing(latest.cpu_load);\n    document.querySelectorAll('[data-convert]').forEach(el => {\n      const key = el.getAttribute('data-convert');\n      const raw = latest[key];\n      if (!showConversions || raw === undefined) {\n        el.textContent = '';\n        return;\n      }\n      el.textContent = key === 'uptime' ? minuteExtra(raw) : byteExtra(raw);\n    });\n    const button = document.getElementById('units');\n    if (button) {\n      button.textContent = showConversions ? 'Hide conversions' : 'Show conversions';\n      button.setAttribute('aria-pressed', String(showConversions));\n    }\n  }\n\n  function stamp(text) {\n    const el = document.querySelector('[data-field=updated]');\n    if (el) el.textContent = text;\n  }\n\n  async function refresh() {\n    if (busy) return;\n    busy = true;\n    try {\n      const response = await fetch(statusUrl, { cache: 'no-store' });\n      const text = await response.text();\n      const data = {};\n      text.split('|').forEach(part => {\n        const idx = part.indexOf('=');\n        if (idx > 0) data[part.slice(0, idx)] = part.slice(idx + 1);\n      });\n      latest = data;\n      render();\n      stamp(new Date().toLocaleTimeString());\n    } catch (error) {\n      stamp('offline: ' + error.message);\n    } finally {\n      busy = false;\n    }\n  }\n\n  const unitsButton = document.getElementById('units');\n  if (unitsButton) unitsButton.addEventListener('click', () => {\n    showConversions = !showConversions;\n    render();\n  });\n\n  refresh();\n  setInterval(refresh, 1000);\n})();"

## One poll returns every metric. Strings are built with += because a long
## chain of + operators overflows the ESP32 loopTask stack in the interpreter.
fn read_status():
	v body string = ""
	body += "uptime="
	body += str(RSSystem.uptime())
	body += "|heap_free="
	body += str(RSSystem.memory_free())
	body += "|heap_min="
	body += str(RSSystem.memory_min_free())
	body += "|heap_total="
	body += str(RSSystem.memory_total())
	body += "|cpu_load="
	body += str(RSSystem.cpu_load())
	body += "|cpu_speed="
	body += str(RSSystem.cpu_speed())
	body += "|chip="
	body += RSSystem.chip_model()
	body += "|chip_revision="
	body += str(RSSystem.chip_revision())
	body += "|cores="
	body += str(RSSystem.cpu_cores())
	body += "|psram="
	body += str(RSSystem.psram_size())
	body += "|flash_used="
	body += str(RSSystem.flash_used())
	body += "|flash_total="
	body += str(RSSystem.flash_total())
	body += "|modules="
	body += RSSystem.modules()
	return body

START():
	print_cmd("ESP32 live dashboard")
	print_cmd("=== hardware report ===")
	print_cmd(RSSystem.report())

	wifi.set_route_mode(RSNetwork[ROUTEMODE_SR])
	wifi.set_route_info(ap_ssid, ap_password)
	print_cmd("AP: " + wifi.get_own_route_info())
	print_cmd("IP: " + wifi.get_ip(ap_ssid))

	page.create_server(port_number)
	page.set_page_content(html_page)
	page.set_client_script(rsclient_js)
	page.start_server()
	v url string = "Dashboard: http://"
	url += wifi.get_ip(ap_ssid)
	url += ":"
	url += str(port_number)
	print_cmd(url)

PROCESS(FPS):
	page.process()
	print_cmd(str(RSSystem.uptime()) + " s uptime")
	if page.get_request_state():
		v tick string = page.request_string_data()
		page.respond_string_data(read_status())
